<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 双目标：net8.0（LTS，兼容面最广）+ net10.0（当前 LTS）
         两者均为非自包含单文件发布，运行端需装对应大版本运行时，见 README「环境要求」。
         构建 net10.0 需 .NET SDK 10；仅装 SDK 8 时可用 -p:TargetFrameworks=net8.0 只构建 net8.0。 -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 单文件发布 + 仅依赖 NewLife 生态；InvariantGlobalization 去除系统区域依赖 -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>NewLife.OllamaHub</AssemblyName>
    <RootNamespace>NewLife.OllamaHub</RootNamespace>
    <!-- 硬约束：公共 API 必须 XML 注释（newlife-global-standards） -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 版本号编码构建日期+时间，对齐 NewLife 系列组件显示风格：
         AssemblyVersion = major.minor.<距2000-01-01天数>.<自午夜起的半秒数>（ax.Version 显示，等价于 NewLife.Agent 的 10.17.9709.31882）
         FileVersion     = major.minor.<YYYY>.<MMDD>（人类可读日期，等价于 NewLife.Agent 的 10.17.2026.0801） -->
    <_BuildDays>$([System.DateTime]::Now.Subtract($([System.DateTime]::Parse('2000-01-01'))).Days)</_BuildDays>
    <_BuildHalfSeconds>$([System.Convert]::ToInt32($([MSBuild]::Divide($([System.DateTime]::Now.TimeOfDay.TotalSeconds), 2))))</_BuildHalfSeconds>
    <_BuildYear>$([System.DateTime]::Now.Year)</_BuildYear>
    <_BuildMmdd>$([System.DateTime]::Now.ToString('MMdd'))</_BuildMmdd>
    <Version>1.0.$(_BuildYear).$(_BuildMmdd)</Version>
    <AssemblyVersion>1.0.$(_BuildDays).$(_BuildHalfSeconds)</AssemblyVersion>
    <FileVersion>1.0.$(_BuildYear).$(_BuildMmdd)</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- 仅引用 NewLife 生态 NuGet，无任何第三方（含 Microsoft.Extensions.*）
         版本跟随上游最新稳定版；NewLife.Core 12.x 为大版本升级，升级后必须双框架回归 self-test -->
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
    <PackageReference Include="NewLife.Agent" Version="10.18.2026.1024" />
  </ItemGroup>
  <ItemGroup>
    <!-- 内嵌 Web 管理面板 HTML（随单文件 exe 打包，离线可用） -->
    <EmbeddedResource Include="Http\AdminPanel.html" />
  </ItemGroup>
</Project>
