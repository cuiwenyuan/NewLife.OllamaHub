<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 双目标：net8.0（LTS，兼容面最广）+ net10.0（当前 LTS）
         两者均为非自包含单文件发布，运行端需装对应大版本运行时，见 README「环境要求」。
         构建 net10.0 需 .NET SDK 10；仅装 SDK 8 时可用 -p:TargetFrameworks=net8.0 只构建 net8.0。 -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 单文件发布 + 仅依赖 NewLife 生态；InvariantGlobalization 去除系统区域依赖 -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>NewLife.OllamaHub</AssemblyName>
    <RootNamespace>NewLife.OllamaHub</RootNamespace>
    <!-- 硬约束：公共 API 必须 XML 注释（newlife-global-standards） -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 版本号规则对齐 NewLife 全家桶主干库（NewLife.Core / XCode / Redis / Remoting / Stardust）：
         AssemblyVersion = FileVersion = 主.次.<YYYY>.<MMDD>，例如 12.0.2026.1024 / 1.3.2026.1113。
         只含日期、不含时刻 → 同一天任意次构建版本号恒定（幂等），天然满足「一天一个版本号」；
         年+月日单调递增 → 升级比较无需任何额外逻辑。
         ProductVersion 由 SDK 追加 "+<提交号>"（CI 注入 SourceRevisionId），可从 exe 直接追溯源码版本。
         主.次为语义版本，发版时手工递增（与 NewLife 全家桶一致）。
         发版时 CI 以 tag（v1.3.2026.1113）传 -p:Version=1.3.2026.1113 覆盖；AssemblyVersion/FileVersion
         一律取自 $(Version)，保证「tag 版本 == 程序集版本 == 文件版本」不因构建日期漂移。 -->
    <BaseVersion Condition="'$(BaseVersion)' == ''">1.3</BaseVersion>
    <_BuildYear>$([System.DateTime]::Now.Year)</_BuildYear>
    <_BuildMmdd>$([System.DateTime]::Now.ToString('MMdd'))</_BuildMmdd>
    <Version Condition="'$(Version)' == ''">$(BaseVersion).$(_BuildYear).$(_BuildMmdd)</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- 仅引用 NewLife 生态 NuGet，无任何第三方（含 Microsoft.Extensions.*）
         版本跟随上游最新稳定版；NewLife.Core 12.x 为大版本升级，升级后必须双框架回归 self-test -->
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
    <PackageReference Include="NewLife.Agent" Version="10.18.2026.1024" />
  </ItemGroup>
  <ItemGroup>
    <!-- 内嵌 Web 管理面板 HTML（随单文件 exe 打包，离线可用） -->
    <EmbeddedResource Include="Http\AdminPanel.html" />
  </ItemGroup>
</Project>
